(version 1)
(allow default)
;; Secrets: kernel-enforced read/write deny for sandboxed agent CLIs. __HOME__ is replaced by install.sh.
(deny file-read* file-write*
  (regex #"/\.env$")
  (regex #"/\.env\.[^/]*$")
  (regex #"\.(pem|key|p12|pfx|keystore|jks)$")
  (regex #"/id_(rsa|ed25519|ecdsa|dsa)[^/]*$")
  (regex #"(service[-_]account|credentials)[^/]*\.json$")
  (regex #"/\.npmrc$")
  (regex #"/\.netrc$")
  (subpath "__HOME__/.ssh")
  (subpath "__HOME__/.aws")
  (subpath "__HOME__/.config/gcloud")
  (subpath "__HOME__/.gemini")
  (subpath "__HOME__/.codex")
  (subpath "__HOME__/.claude/.credentials.json")
  (subpath "__HOME__/Library/Keychains"))
;; templates are fine
(allow file-read* (regex #"/\.env\.(example|sample|template)$"))
