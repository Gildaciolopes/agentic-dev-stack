# agentic-dev-stack configuration.
# The CLI copies this file to ~/.config/agentic-dev-stack/stack.env on first run; edit that copy.

# Where your projects live (used by the daily digest and add-project.py defaults)
PROJECTS_DIR="$HOME/projects"

# Your git author email (daily digest counts your commits). Leave empty to use `git config --global user.email`.
GIT_AUTHOR_EMAIL=""

# Timezone for schedules (IANA name)
TIMEZONE="America/Sao_Paulo"

# Free-model curator runs (HH:MM, space-separated)
CURATOR_TIMES="07:30 13:30 19:30"

# Daily digest: collector time and Hermes summary time
DIGEST_COLLECT_TIME="07:50"
DIGEST_SEND_TIME="08:00"

# Hermes messaging platform: discord | telegram | none
HERMES_PLATFORM="discord"

# Language of Hermes summaries (e.g. "English", "Português do Brasil", "Español")
SUMMARY_LANGUAGE="English"

# Language of the blocks add-project appends to CLAUDE.md/AGENTS.md: en | pt-BR
PROJECT_DOCS_LANG="en"

# alethe pinned commit (audited). Change only after auditing a newer commit.
ALETHE_REPO="https://github.com/Kc1t/alethe-orchestrate-skill"
ALETHE_COMMIT="ab81104"

# Optional workers: set to 1 to include
WITH_AGY=1
WITH_OPENCODE=1
WITH_CODEX=0        # requires a ChatGPT plan; see docs/04-codex-e-outros-clis.md
WITH_HEADROOM=0

# Windows only: there is no kernel sandbox for the free-model worker. 1 = accept the risk
# (isolated worktrees + OpenCode permissions only). Prefer WSL2.
ALLOW_UNSANDBOXED_FREE_WORKER=0
